<Window x:Class="AgentDesk.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI客服"
        Icon="Assets/ai-customer-service.ico"
        Width="1500" Height="900" MinWidth="1200" MinHeight="680"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="288" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Background="White">
            <Grid Margin="16,24,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64" />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="168" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Width="40" Height="40" Source="Assets/ai-customer-service-logo.png" Stretch="UniformToFill" AutomationProperties.Name="AI客服 Logo">
                        <Image.Clip><RectangleGeometry Rect="0,0,40,40" RadiusX="9" RadiusY="9" /></Image.Clip>
                    </Image>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="AI客服" FontSize="{StaticResource FontSizeSectionTitle}" LineHeight="{StaticResource LineHeightSectionTitle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ApplicationVersionText}" Style="{StaticResource HelperText}" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="12" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{StaticResource InkBrush}">
                            <TextBlock Text="秦" Foreground="White" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="秦岚" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" />
                            <TextBlock Text="客服主管 · 本机控制" Style="{StaticResource HelperText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Overview">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsOverviewSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="01   总览" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Accounts">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsAccountsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="02   窗口校准" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Knowledge">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsKnowledgeSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="03   知识库" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="MemorySkills">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsMemorySkillsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="04   记忆与技能" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Sizing">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSizingSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="05   商品尺码" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Rules">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsRulesSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="06   运行策略" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Logs">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsLogsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="07   运行记录" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="TestLab">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsTestLabSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="08   测试实验室" />
                    </Button>
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Settings">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource NavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsSettingsSelected}" Value="True"><Setter Property="Background" Value="{StaticResource MintBrush}" /><Setter Property="BorderBrush" Value="{StaticResource InkBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger></Style.Triggers></Style></Button.Style>
                        <TextBlock Text="09   系统设置" />
                    </Button>
                </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="4" CornerRadius="13" Background="{StaticResource MintBrush}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="当前安全状态" Style="{StaticResource Kicker}" />
                        <TextBlock Text="{Binding LiveGateTitle}" Margin="0,8,0,0" FontSize="{StaticResource FontSizeSectionTitle}" LineHeight="{StaticResource LineHeightSectionTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding LiveGateDescription}" Margin="0,4,0,12" Style="{StaticResource HelperText}" />
                        <Button Content="检查上线准备" Command="{Binding NavigateCommand}" CommandParameter="Overview" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="24,0,24,16" MaxWidth="{StaticResource ContentMaxWidth}" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions><RowDefinition Height="88" /><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AI客服 CONTROL" Style="{StaticResource Kicker}" />
                    <TextBlock Text="客服平台是唯一对话界面" FontSize="{StaticResource FontSizeBody}" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource MintBrush}" CornerRadius="11" Padding="12,7" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ExecutionModeText}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeSecondary}" />
                    </Border>
                    <Button Content="紧急停止  Ctrl+Alt+S" Style="{StaticResource DangerButton}" Command="{Binding StopServiceCommand}" Margin="0,0,8,0" />
                    <Button Content="{Binding ServiceButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding ToggleServiceCommand}" />
                </StackPanel>
            </Grid>

            <!-- 总览 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Overview}" IsEnabled="{Binding IsOverviewSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="{StaticResource PageHeaderMargin}"><TextBlock Text="上线准备与实时状态" Style="{StaticResource Kicker}" /><TextBlock Text="智能客服总览" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.65*" /></Grid.ColumnDefinitions>
                        <Border CornerRadius="18" Background="{StaticResource MintBrush}" Padding="22">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="当前运行状态" Style="{StaticResource Kicker}" />
                                    <TextBlock Text="{Binding ServiceStatusText}" Margin="0,9,0,0" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ExecutionModeDescription}" Margin="0,9,24,16" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal"><Button Content="配置运行策略" Command="{Binding NavigateCommand}" CommandParameter="Rules" Margin="0,0,8,0" /><Button Content="进入模拟验收" Command="{Binding NavigateCommand}" CommandParameter="TestLab" /></StackPanel>
                                </StackPanel>
                                <Border Grid.Column="1" Background="White" CornerRadius="14" Padding="16">
                                    <StackPanel><TextBlock Text="最近异常" Style="{StaticResource Kicker}" /><TextBlock Text="{Binding RecentErrorText}" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="SemiBold" /><TextBlock Text="运行异常、尺寸漂移或限额触发都会自动停机。" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="上线顺序" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="按顺序完成，自动发送才会解锁。" Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" />
                                <ItemsControl ItemsSource="{Binding ReadinessItems}">
                                    <ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding TargetPage}" Padding="10" Margin="0,0,0,6" HorizontalContentAlignment="Stretch"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Number}" Foreground="{StaticResource MutedBrush}" FontWeight="Bold" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" HorizontalAlignment="Right" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" FontWeight="SemiBold" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <UniformGrid Columns="4" Margin="0,14,0,14">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"><StackPanel><TextBlock Text="今日已发送" Style="{StaticResource Kicker}" /><TextBlock Text="{Binding TodaySentCount}" FontSize="{StaticResource FontSizeMetric}" LineHeight="{StaticResource LineHeightMetric}" FontWeight="Bold" /><TextBlock Text="仅统计真实平台成功发送" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel></Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"><StackPanel><TextBlock Text="今日转人工" Style="{StaticResource Kicker}" /><TextBlock Text="{Binding TodayHumanCount}" FontSize="{StaticResource FontSizeMetric}" LineHeight="{StaticResource LineHeightMetric}" FontWeight="Bold" /><TextBlock Text="高风险或依据不足" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel></Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0"><StackPanel><TextBlock Text="运行模式" Style="{StaticResource Kicker}" /><TextBlock Text="{Binding ExecutionModeText}" FontSize="{StaticResource FontSizeSectionTitle}" LineHeight="{StaticResource LineHeightSectionTitle}" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock Text="默认影子观察" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel></Border>
                        <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="已审核上下文" Style="{StaticResource Kicker}" /><TextBlock Text="{Binding KnowledgeAndSizingCountText}" FontSize="{StaticResource FontSizeBody}" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock Text="配置变化会撤销批准" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel></Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- 窗口校准 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Accounts}" IsEnabled="{Binding IsAccountsSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="{StaticResource PageHeaderMargin}"><TextBlock Text="真实平台接入 · 所有测试均不发送消息" Style="{StaticResource Kicker}" /><TextBlock Text="客服窗口发现与可视化校准" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="1 · 选择客服窗口" Style="{StaticResource SectionTitle}" /><TextBlock Text="当前电脑可见窗口" Style="{StaticResource Kicker}" Margin="0,14,0,6" /><ComboBox ItemsSource="{Binding PlatformWindows}" SelectedItem="{Binding SelectedPlatformWindow}" DisplayMemberPath="DisplayName" MinHeight="{StaticResource ControlHeight}" AutomationProperties.Name="可见客服窗口" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="刷新窗口" Command="{Binding RefreshWindowsCommand}" /><Button Grid.Column="2" Content="使用选中窗口" Style="{StaticResource PrimaryButton}" Command="{Binding UseSelectedWindowCommand}" /></Grid><TextBlock Text="窗口标题匹配" Style="{StaticResource Kicker}" Margin="0,14,0,6" /><TextBox Text="{Binding WindowTitleContains}" AutomationProperties.Name="窗口标题匹配" /><TextBlock Text="{Binding CalibrationStatus}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /></StackPanel></Border>
                            <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"><StackPanel><TextBlock Text="2 · 标定位置" Style="{StaticResource SectionTitle}" /><TextBlock Text="先测试截图，再选择标定对象并点击右侧预览。" Margin="0,6,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><Button Content="测试截图并刷新预览" Style="{StaticResource PrimaryButton}" Command="{Binding CapturePlatformCommand}" /><Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="标定输入框" Command="{Binding SelectCalibrationTargetCommand}" CommandParameter="Input" /><Button Grid.Column="2" Content="标定发送按钮" Command="{Binding SelectCalibrationTargetCommand}" CommandParameter="Send" /></Grid><TextBlock Text="{Binding CalibrationTarget, StringFormat=当前标定：{0}}" Margin="0,9,0,0" FontWeight="SemiBold" /><TextBlock Text="{Binding CapturedWindowText}" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel></Border>
                        </StackPanel>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid><StackPanel><TextBlock Text="客服窗口截图预览" Style="{StaticResource SectionTitle}" /><TextBlock Text="点击截图中的真实输入框或发送按钮完成相对坐标标定。" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" /></StackPanel><Border Background="{StaticResource MintBrush}" CornerRadius="10" Padding="10,5" HorizontalAlignment="Right"><TextBlock Text="不会发送" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></Border></Grid>
                                <Border Grid.Row="1" Background="{StaticResource CanvasBrush}" CornerRadius="12" Margin="0,14,0,14" MinHeight="390" ClipToBounds="True">
                                    <Grid><TextBlock Text="尚无截图，请先在左侧选择窗口并点击“测试截图并刷新预览”" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center" /><Image x:Name="CalibrationPreviewImage" Source="{Binding CalibrationPreview}" Stretch="Uniform" MouseLeftButtonDown="OnCalibrationPreviewClick" Cursor="Cross" AutomationProperties.Name="客服窗口校准预览" /></Grid>
                                </Border>
                                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="坐标与安全参数" FontWeight="Bold" /><TextBlock Text="{Binding InputX, StringFormat=输入框 X {0:F3}}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding InputY, StringFormat=输入框 Y {0:F3}}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding SendX, StringFormat=发送按钮 X {0:F3}}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding SendY, StringFormat=发送按钮 Y {0:F3}}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button Content="恢复默认" Command="{Binding ResetCalibrationCommand}" Margin="0,0,8,0" /><Button Content="保存校准" Command="{Binding SaveCalibrationCommand}" Margin="0,0,8,0" /><Button Content="只测试输入框点击" Style="{StaticResource PrimaryButton}" Command="{Binding TestInputPointCommand}" /></StackPanel></Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 知识库 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Knowledge}" IsEnabled="{Binding IsKnowledgeSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="{StaticResource PageHeaderMargin}"><TextBlock Text="只有已审核且启用的内容才会提供给 Qwen" Style="{StaticResource Kicker}" /><TextBlock Text="本地知识库" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="380" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel><TextBlock Text="{Binding KnowledgeEditorTitle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="标题（2–100 字）" Style="{StaticResource Kicker}" Margin="0,14,0,6" /><TextBox Text="{Binding KnowledgeTitleInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" AutomationProperties.Name="知识标题" /><TextBlock Text="适用账号" Style="{StaticResource Kicker}" Margin="0,12,0,6" /><TextBox Text="{Binding KnowledgeAccountScope}" MaxLength="80" AutomationProperties.Name="知识适用账号" /><TextBlock Text="知识正文（2–4000 字）" Style="{StaticResource Kicker}" Margin="0,12,0,6" /><TextBox Text="{Binding KnowledgeContentInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="4000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170" VerticalContentAlignment="Top" AutomationProperties.Name="知识正文" /><Button Content="{Binding KnowledgeSaveButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding AddKnowledgeCommand}" Margin="0,12,0,0" /><Button Content="取消编辑" Command="{Binding CancelKnowledgeEditCommand}" Margin="0,8,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEditingKnowledge}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><TextBlock Text="任何新增、修改、停用或删除都会撤销旧的正式模式批准。" Margin="0,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid><TextBlock Text="已保存知识" Style="{StaticResource SectionTitle}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="导入 JSON" Command="{Binding ImportKnowledgeCommand}" Margin="0,0,8,0" /><Button Content="导出 JSON" Command="{Binding ExportKnowledgeCommand}" /></StackPanel></Grid>
                                <Grid Grid.Row="1" Margin="0,14,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="搜索标题、正文或账号" Style="{StaticResource Kicker}" Margin="0,0,0,5" /><TextBox Text="{Binding KnowledgeSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索知识" /></StackPanel><Border Grid.Column="1" Background="{StaticResource MintBrush}" CornerRadius="11" Padding="12,6" Margin="10,17,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding KnowledgeCountText}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" FontWeight="Bold" /></Border></Grid>
                                <Grid Grid.Row="2" MinHeight="430">
                                    <Border Background="{StaticResource CanvasBrush}" CornerRadius="12" Padding="30"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasKnowledgeItems}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="知识库还是空的" FontSize="{StaticResource FontSizeSectionTitle}" LineHeight="{StaticResource LineHeightSectionTitle}" FontWeight="Bold" HorizontalAlignment="Center" /><TextBlock Text="先在左侧添加一条真实商品库存、发货时效或售后口径。没有可靠知识时，正式回复会转人工。" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" MaxWidth="430" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Border>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding KnowledgeItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CanvasBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="210" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding Content}" Margin="0,6,18,0" TextWrapping="Wrap" MaxHeight="72" /><TextBlock Text="{Binding AccountScope, StringFormat=适用：{0}}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding Status}" Foreground="{StaticResource SuccessBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="编辑" Command="{Binding DataContext.EditKnowledgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" /><Button Content="{Binding ToggleText}" Command="{Binding DataContext.ToggleKnowledgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" /><Button Content="删除" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteKnowledgeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 记忆与技能 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=MemorySkills}" IsEnabled="{Binding IsMemorySkillsSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="{StaticResource PageHeaderMargin}">
                        <StackPanel><TextBlock Text="可控积累 · 人工审核 · 可随时撤销" Style="{StaticResource Kicker}" /><TextBlock Text="记忆体与客服技能" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource WarningSoftBrush}" CornerRadius="11" Padding="13,8"><TextBlock Text="候选记忆与待审核技能绝不参与回复" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}" /></Border>
                    </Grid>
                    <TabControl Background="Transparent" BorderThickness="0" Padding="0">
                        <TabItem Header="  记忆体  ">
                            <StackPanel Margin="0,14,0,0">
                                <Border Background="{StaticResource MintBrush}" CornerRadius="13" Padding="16" Margin="0,0,0,12">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="三层记忆：当前请求 → 脱敏候选 → 人工批准的长期记忆" FontWeight="Bold" /><TextBlock Text="不保存聊天原文、截图、客户昵称、地址、联系方式或整段回复；“发送成功”不代表经验正确。" Margin="0,5,18,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="导入候选" Command="{Binding ImportMemoriesCommand}" Margin="0,0,8,0" /><Button Content="导出备份" Command="{Binding ExportMemoriesCommand}" /></StackPanel></Grid>
                                </Border>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="390" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding MemoryEditorTitle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="标题" Style="{StaticResource Kicker}" Margin="0,13,0,5" /><TextBox Text="{Binding MemoryTitleInput, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="记忆标题" /><TextBlock Text="可复用经验" Style="{StaticResource Kicker}" Margin="0,10,0,5" /><TextBox Text="{Binding MemoryContentInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="96" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="记忆内容" /><TextBlock Text="标签（逗号分隔）" Style="{StaticResource Kicker}" Margin="0,10,0,5" /><TextBox Text="{Binding MemoryTagsInput}" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="适用账号" Style="{StaticResource Kicker}" /><TextBox Text="{Binding MemoryAccountScope}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="商品标识（可空）" Style="{StaticResource Kicker}" /><TextBox Text="{Binding MemoryProductKey}" Margin="0,5,0,0" /></StackPanel></Grid><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{Binding MemorySaveButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveMemoryCommand}" /><Button Grid.Column="2" Content="取消编辑" Command="{Binding CancelMemoryEditCommand}" Visibility="{Binding IsEditingMemory, Converter={StaticResource BooleanVisibility}}" /></Grid></StackPanel></Border>
                                        <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0"><StackPanel><TextBlock Text="自动积累设置" Style="{StaticResource SectionTitle}" /><CheckBox Content="从真实影子/自动运行结果生成脱敏候选" IsChecked="{Binding AutoLearningEnabled}" Margin="0,12,0,0" /><TextBlock Text="候选上限（50–5000）" Style="{StaticResource Kicker}" Margin="0,10,0,5" /><TextBox Text="{Binding MemoryCandidateLimit}" /><Button Content="保存积累设置" Command="{Binding SaveMemorySettingsCommand}" Margin="0,12,0,0" /><TextBlock Text="候选只记录意图、风险、结果和稳定规则 ID，需人工补充做法并批准。" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel></Border>
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource CardBorder}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="记忆审核队列" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding MemoryCountText}" Style="{StaticResource Kicker}" Margin="0,4,0,0" /></StackPanel><ComboBox Grid.Column="1" ItemsSource="{Binding MemoryFilters}" SelectedItem="{Binding MemoryFilter}" MinHeight="{StaticResource ControlHeight}" /></Grid><TextBox Text="{Binding MemorySearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,10" AutomationProperties.Name="搜索记忆" /><Border Background="{StaticResource CanvasBrush}" CornerRadius="12" Padding="28" Visibility="{Binding HasMemoryItems, Converter={StaticResource BooleanVisibility}}"><TextBlock Text="记忆列表" FontWeight="Bold" /></Border><ItemsControl ItemsSource="{Binding MemoryItems}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CanvasBrush}" CornerRadius="10" Padding="13" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding Content}" Margin="0,5,20,0" TextWrapping="Wrap" /><TextBlock Text="{Binding ScopeText, StringFormat=适用：{0}}" Margin="0,5,0,0" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding EvidenceText}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="批准" Command="{Binding DataContext.ApproveMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanApprove}" Margin="0,0,6,0" /><Button Content="编辑" Command="{Binding DataContext.EditMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" /><Button Content="{Binding ToggleText}" Command="{Binding DataContext.ToggleMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanToggle}" Margin="0,0,6,0" /><Button Content="删除" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteMemoryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                                </Grid>
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="  技能中心  ">
                            <StackPanel Margin="0,14,0,0">
                                <Border Background="{StaticResource MintBrush}" CornerRadius="13" Padding="16" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="已内置 5 个原创改写的客服技能" FontWeight="Bold" /><TextBlock Text="参考 Agent Skills 目录/SKILL.md 规范与 GitHub support-skills 思路；本软件只采用可审核的文本策略，不导入脚本、Shell 命令或外部写入动作。" Margin="0,5,18,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="恢复推荐" Command="{Binding RestoreRecommendedSkillsCommand}" Margin="0,0,8,0" /><Button Content="导入待审核" Command="{Binding ImportSkillsCommand}" Margin="0,0,8,0" /><Button Content="导出技能" Command="{Binding ExportSkillsCommand}" /></StackPanel></Grid></Border>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="420" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="{Binding SkillEditorTitle}" Style="{StaticResource SectionTitle}" /><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="技能名" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SkillNameInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="分类" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SkillCategoryInput}" Margin="0,5,0,0" /></StackPanel></Grid><TextBlock Text="作用说明" Style="{StaticResource Kicker}" Margin="0,10,0,5" /><TextBox Text="{Binding SkillDescriptionInput, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" /><TextBlock Text="触发词（逗号分隔）" Style="{StaticResource Kicker}" Margin="0,10,0,5" /><TextBox Text="{Binding SkillTriggersInput}" /><CheckBox Content="每次回复都应用" IsChecked="{Binding SkillAlwaysApply}" Margin="0,9,0,0" /><TextBlock Text="可执行的回复策略" Style="{StaticResource Kicker}" Margin="0,10,0,5" /><TextBox Text="{Binding SkillInstructionsInput, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="130" TextWrapping="Wrap" VerticalContentAlignment="Top" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="140" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="来源链接（可空）" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SkillSourceUrlInput}" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="授权/备注" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SkillLicenseInput}" Margin="0,5,0,0" /></StackPanel></Grid><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{Binding SkillSaveButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSkillCommand}" /><Button Grid.Column="2" Content="取消编辑" Command="{Binding CancelSkillEditCommand}" Visibility="{Binding IsEditingSkill, Converter={StaticResource BooleanVisibility}}" /></Grid></StackPanel></Border>
                                    <Border Grid.Column="2" Style="{StaticResource CardBorder}"><StackPanel><Grid><StackPanel><TextBlock Text="已安装技能" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding SkillCountText}" Style="{StaticResource Kicker}" Margin="0,4,0,0" /></StackPanel><TextBox Text="{Binding SkillSearch, UpdateSourceTrigger=PropertyChanged}" Width="230" HorizontalAlignment="Right" AutomationProperties.Name="搜索客服技能" /></Grid><ItemsControl ItemsSource="{Binding SkillItems}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CanvasBrush}" CornerRadius="10" Padding="13" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding Category, StringFormat=  /  {0}}" Foreground="{StaticResource MutedBrush}" /></StackPanel><TextBlock Text="{Binding Description}" Margin="0,5,20,0" TextWrapping="Wrap" /><TextBlock Text="{Binding TriggerText, StringFormat=触发：{0}}" Margin="0,5,0,0" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding SourceText}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Status}" Margin="0,4,0,0" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="批准" Command="{Binding DataContext.ApproveSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanApprove}" Margin="0,0,6,0" /><Button Content="编辑" Command="{Binding DataContext.EditSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" /><Button Content="{Binding ToggleText}" Command="{Binding DataContext.ToggleSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding CanToggle}" Margin="0,0,6,0" /><Button Content="删除" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteSkillCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                                </Grid>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </ScrollViewer>

            <!-- 商品尺码 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Sizing}" IsEnabled="{Binding IsSizingSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="{StaticResource PageHeaderMargin}">
                        <TextBlock Text="一个商品版本一套规则 · 不跨款式猜尺码" Style="{StaticResource Kicker}" />
                        <TextBlock Text="商品分类与尺码规则" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" />
                    </StackPanel>
                    <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                        <TextBlock Text="安全原则：同一链接的常规版、加长版要分别保存；商品或版本识别不清、客户数据不足、同时命中多个尺码时，智能客服不会给出明确尺码。" TextWrapping="Wrap" />
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid>
                                <StackPanel><TextBlock Text="{Binding SizingEditorTitle}" Style="{StaticResource SectionTitle}" /><TextBlock Text="商品标识请填写客服截图中能看到的 SKU 或标题；链接不会自动抓取网页。保存即表示你已核对官方尺码表。" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" /></StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="导入 JSON" Command="{Binding ImportSizingProfilesCommand}" Margin="0,0,8,0" /><Button Content="导出 JSON" Command="{Binding ExportSizingProfilesCommand}" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.8*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="商品链接" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SizingProductUrlInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="商品链接" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="商品标识 / SKU" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SizingProductKeyInput, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" AutomationProperties.Name="商品标识或SKU" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="适用账号" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SizingAccountScope}" Margin="0,6,0,0" AutomationProperties.Name="尺码规则适用账号" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="1.6*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="品类" Style="{StaticResource Kicker}" /><ComboBox ItemsSource="{Binding SizingCategories}" Text="{Binding SizingCategoryInput, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,6,0,0" MinHeight="{StaticResource ControlHeight}" AutomationProperties.Name="商品品类" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="版型" Style="{StaticResource Kicker}" /><ComboBox ItemsSource="{Binding SizingFits}" Text="{Binding SizingFitInput, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,6,0,0" MinHeight="{StaticResource ControlHeight}" AutomationProperties.Name="商品版型" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="版本" Style="{StaticResource Kicker}" /><ComboBox ItemsSource="{Binding SizingVariants}" Text="{Binding SizingVariantInput, UpdateSourceTrigger=PropertyChanged}" IsEditable="True" Margin="0,6,0,0" MinHeight="{StaticResource ControlHeight}" AutomationProperties.Name="商品版本" /></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Text="向客户追问的测量提示" Style="{StaticResource Kicker}" /><TextBox Text="{Binding SizingMeasurementGuide}" Margin="0,6,0,0" AutomationProperties.Name="测量提示" /></StackPanel>
                            </Grid>

                            <Grid Margin="0,16,0,8"><TextBlock Text="尺码表（数值单位：cm / kg；120斤请换算为60kg）" FontWeight="Bold" /><Button Content="＋ 添加尺码行" Command="{Binding AddSizingRowCommand}" HorizontalAlignment="Right" /></Grid>
                            <DataGrid ItemsSource="{Binding SizingRows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" MinHeight="210" MaxHeight="300" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrush}" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="商品尺码规则表">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="尺码" Width="76" Binding="{Binding Size, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTextColumn Header="身高下限" Width="96" Binding="{Binding MinHeightCm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="身高上限" Width="96" Binding="{Binding MaxHeightCm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="体重下限" Width="96" Binding="{Binding MinWeightKg, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="体重上限" Width="96" Binding="{Binding MaxWeightKg, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="腰围下限" Width="96" Binding="{Binding MinWaistCm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="腰围上限" Width="96" Binding="{Binding MaxWaistCm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="胸围下限" Width="96" Binding="{Binding MinBustCm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="胸围上限" Width="96" Binding="{Binding MaxBustCm, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" />
                                    <DataGridTextColumn Header="备注" Width="220" Binding="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                    <DataGridTemplateColumn Header="操作" Width="104"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="删除行" Style="{StaticResource DangerButton}" MinHeight="{StaticResource ControlHeight}" Padding="10,4" Command="{Binding DataContext.RemoveSizingRowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="取消编辑" Command="{Binding CancelSizingEditCommand}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEditingSizing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                                <Button Content="{Binding SizingSaveButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSizingProfileCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="0.55*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid><TextBlock Text="已保存商品版本" Style="{StaticResource SectionTitle}" /><Border Background="{StaticResource MintBrush}" CornerRadius="10" Padding="10,5" HorizontalAlignment="Right"><TextBlock Text="{Binding SizingCountText}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" FontWeight="Bold" /></Border></Grid>
                                <TextBox Grid.Row="1" Text="{Binding SizingSearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,12,0,10" AutomationProperties.Name="搜索商品尺码规则" />
                                <Grid Grid.Row="2" MinHeight="320">
                                    <Border Background="{StaticResource CanvasBrush}" CornerRadius="12" Padding="26"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasSizingProfiles}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="还没有商品尺码规则" FontSize="{StaticResource FontSizeSectionTitle}" LineHeight="{StaticResource LineHeightSectionTitle}" FontWeight="Bold" /><TextBlock Text="先为一个真实商品链接添加品类、版型、版本和官方尺码表。" Margin="0,7,0,0" Foreground="{StaticResource MutedBrush}" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel></Border>
                                    <ListBox ItemsSource="{Binding SizingProfiles}" SelectedItem="{Binding SelectedSizingProfile}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="已保存商品尺码规则"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CanvasBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="218" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ProductKey}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" FontWeight="Bold" /><TextBlock Text="{Binding Classification}" Margin="0,4,0,0" /><TextBlock Text="{Binding RowSummary, StringFormat=尺码：{0}}" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding AccountScope, StringFormat=适用：{0}}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" Foreground="{StaticResource MutedBrush}" /><TextBlock Text="{Binding Status}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" Foreground="{StaticResource SuccessBrush}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="编辑" Command="{Binding DataContext.EditSizingProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" /><Button Content="{Binding ToggleText}" Command="{Binding DataContext.ToggleSizingProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,6,0" /><Button Content="删除" Style="{StaticResource DangerButton}" Command="{Binding DataContext.DeleteSizingProfileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Background="{StaticResource MintBrush}">
                            <StackPanel>
                                <TextBlock Text="人工规则试算" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="先在左侧选中一个商品版本。试算只验证规则，不调用模型、不发送消息。" Margin="0,6,0,14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="身高（cm）" Style="{StaticResource Kicker}" /><TextBox Text="{Binding PreviewHeight}" Margin="0,5,0,9" AutomationProperties.Name="试算身高" />
                                <TextBlock Text="体重（kg 或 斤）" Style="{StaticResource Kicker}" /><TextBox Text="{Binding PreviewWeight}" Margin="0,5,0,9" AutomationProperties.Name="试算体重" />
                                <TextBlock Text="腰围（cm，可空）" Style="{StaticResource Kicker}" /><TextBox Text="{Binding PreviewWaist}" Margin="0,5,0,9" AutomationProperties.Name="试算腰围" />
                                <TextBlock Text="胸围（cm，可空）" Style="{StaticResource Kicker}" /><TextBox Text="{Binding PreviewBust}" Margin="0,5,0,12" AutomationProperties.Name="试算胸围" />
                                <Button Content="运行规则试算" Style="{StaticResource PrimaryButton}" Command="{Binding RunSizingPreviewCommand}" />
                                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,12,0,0"><TextBlock Text="{Binding SizingPreviewResult}" TextWrapping="Wrap" /></Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 运行策略 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Rules}" IsEnabled="{Binding IsRulesSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="{StaticResource PageHeaderMargin}"><TextBlock Text="代码安全门优先于模型判断" Style="{StaticResource Kicker}" /><TextBlock Text="运行模式与自动发送规则" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="运行模式" Style="{StaticResource SectionTitle}" /><TextBlock Text="推荐先用影子观察验证真实平台识别，再切换自动发送。" Margin="0,6,0,14" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding ExecutionModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding ExecutionMode}" MinHeight="{StaticResource ControlHeight}" AutomationProperties.Name="运行模式" /><TextBlock Text="{Binding ExecutionModeDescription}" Margin="0,10,0,16" TextWrapping="Wrap" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="每日发送上限" Style="{StaticResource Kicker}" /><TextBox Text="{Binding DailySendLimit}" Margin="0,6,0,0" AutomationProperties.Name="每日自动发送上限" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="每分钟发送上限" Style="{StaticResource Kicker}" /><TextBox Text="{Binding PerMinuteSendLimit}" Margin="0,6,0,0" AutomationProperties.Name="每分钟自动发送上限" /></StackPanel></Grid><Button Content="保存运行策略" Style="{StaticResource PrimaryButton}" Command="{Binding SaveSafetySettingsCommand}" Margin="0,14,0,0" /></StackPanel></Border>
                        <StackPanel Grid.Column="2"><Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="允许自动发送" Style="{StaticResource SectionTitle}" /><TextBlock Text="普通库存、发货和有精确规则依据的尺码咨询" Margin="0,14,0,0" /><TextBlock Text="尺码回复必须匹配当前商品、版型、版本与账号" Margin="0,8,0,0" /><TextBlock Text="回复不超过 500 字且账号、客户、最新消息一致" Margin="0,8,0,0" /><TextBlock Text="发送前再次读取当前会话、账号与商品标识" Margin="0,8,0,0" /></StackPanel></Border><Border Style="{StaticResource CardBorder}" Background="{StaticResource DangerSoftBrush}" Margin="0,12,0,0"><StackPanel><TextBlock Text="始终强制转人工" Style="{StaticResource SectionTitle}" /><TextBlock Text="退款、退货、赔偿、投诉、差评、法律争议" Margin="0,14,0,0" /><TextBlock Text="改价、优惠、改地址、改订单、支付和隐私" Margin="0,8,0,0" /><TextBlock Text="资料不足、商品版本不明、规则重叠、模型异常或消息变化" Margin="0,8,0,0" /></StackPanel></Border><Border Style="{StaticResource CardBorder}" Background="{StaticResource MintBrush}" Margin="0,12,0,0"><StackPanel><TextBlock Text="自动停机保护" Style="{StaticResource SectionTitle}" /><TextBlock Text="达到日/分钟限额、连续 5 次故障或窗口尺寸漂移超过 12% 时立即停止。" Margin="0,10,0,0" TextWrapping="Wrap" /><TextBlock Text="运行中禁止修改模型、知识、尺码、校准和安全策略；Ctrl+Alt+S 可立即停止。" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /></StackPanel></Border></StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- 运行记录 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Logs}" IsEnabled="{Binding IsLogsSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="{StaticResource PageHeaderMargin}"><TextBlock Text="只记录阶段和结果，不保存聊天正文或密钥" Style="{StaticResource Kicker}" /><TextBlock Text="运行记录" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Grid><StackPanel Orientation="Horizontal"><TextBlock Text="筛选" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding LogFilters}" SelectedItem="{Binding LogFilter}" Width="150" MinHeight="{StaticResource ControlHeight}" AutomationProperties.Name="运行记录筛选" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="导出 JSONL" Command="{Binding ExportLogsCommand}" Margin="0,0,8,0" /><Button Content="清理记录" Style="{StaticResource DangerButton}" Command="{Binding ClearLogsCommand}" /></StackPanel></Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="时间" Style="{StaticResource Kicker}" /><TextBlock Grid.Column="1" Text="阶段" Style="{StaticResource Kicker}" /><TextBlock Grid.Column="2" Text="账号" Style="{StaticResource Kicker}" /><TextBlock Grid.Column="3" Text="结果摘要" Style="{StaticResource Kicker}" /><TextBlock Grid.Column="4" Text="级别" Style="{StaticResource Kicker}" /></Grid>
                            <Grid Grid.Row="2" MinHeight="470">
                                <Border Background="{StaticResource CanvasBrush}" CornerRadius="12" Padding="30"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding HasRunEvents}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="暂无符合条件的运行记录" FontSize="{StaticResource FontSizeSectionTitle}" LineHeight="{StaticResource LineHeightSectionTitle}" FontWeight="Bold" /><TextBlock Text="启动影子观察或运行模拟测试后，这里会出现结构化阶段和结果。" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" /></StackPanel></Border>
                                <ItemsControl ItemsSource="{Binding RunEvents}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CanvasBrush}" CornerRadius="9" Padding="12" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="180" /><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" /><TextBlock Grid.Column="1" Text="{Binding Stage}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" /><TextBlock Grid.Column="2" Text="{Binding AccountId}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" /><TextBlock Grid.Column="3" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,14,0" /><TextBlock Grid.Column="4" Text="{Binding SeverityText}" FontWeight="SemiBold" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- 测试实验室 -->
            <Grid Grid.Row="1" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=TestLab}" IsEnabled="{Binding IsTestLabSelected}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid Margin="{StaticResource PageHeaderMargin}"><StackPanel><TextBlock Text="完全隔离 · 不连接真实客户" Style="{StaticResource Kicker}" /><TextBlock Text="上线前人工模拟测试" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel><Border Background="{StaticResource SuccessSoftBrush}" CornerRadius="11" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="SIMULATION · 可安全自动发送" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></Border></Grid>
                <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="手动消息模拟" Style="{StaticResource SectionTitle}" /><TextBlock Text="在隔离环境中扮演客户，观察低风险自动回复与高风险拦截。" Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}" /></StackPanel><Border Grid.Row="1" Background="{StaticResource MintBrush}" CornerRadius="10" Padding="12" Margin="0,0,0,10"><TextBlock Text="退款、改价、投诉、改地址和无可靠依据的消息必须被拦截。" TextWrapping="Wrap" /></Border><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="{StaticResource CanvasBrush}" Padding="10"><ItemsControl ItemsSource="{Binding Transcript}"><ItemsControl.ItemTemplate><DataTemplate><Border Margin="0,0,0,8" Padding="12" CornerRadius="10" MaxWidth="520"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White" /><Setter Property="HorizontalAlignment" Value="Left" /><Style.Triggers><DataTrigger Binding="{Binding IsAgent}" Value="True"><Setter Property="Background" Value="{StaticResource MintStrongBrush}" /><Setter Property="HorizontalAlignment" Value="Right" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding Sender}" FontWeight="Bold" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><TextBlock Text="{Binding Text}" Margin="0,5,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><Grid Grid.Row="3" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions><TextBox Text="{Binding SimulationMessage, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" VerticalContentAlignment="Top" AutomationProperties.Name="模拟客户消息" /><Button Grid.Column="1" Content="模拟客户发送" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding SendSimulationMessageCommand}" /></Grid></Grid></Border>
                    <Border Grid.Column="2" Style="{StaticResource CardBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="自动发送安全门" Style="{StaticResource SectionTitle}" /><TextBlock Text="{Binding LiveGateDescription}" Margin="0,5,0,12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /></StackPanel><Button Grid.Row="1" Content="运行 5 个必测用例" Style="{StaticResource PrimaryButton}" Command="{Binding RunRequiredSuiteCommand}" /><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,10"><ItemsControl ItemsSource="{Binding SuiteResults}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource CanvasBrush}" CornerRadius="9" Padding="10" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Outcome}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding Status}" FontWeight="Bold" /><TextBlock Text="{Binding SendStatus}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><StackPanel Grid.Row="3"><CheckBox Content="我已人工检查自动发送和风险拦截结果" IsChecked="{Binding HumanReviewed}" Margin="0,0,0,10" /><Button Content="测试通过并批准自动发送" Style="{StaticResource PrimaryButton}" Command="{Binding ApproveLiveModeCommand}" /><TextBlock Text="批准只允许选择自动发送模式，不会立即启动真实客服。" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" TextAlignment="Center" /></StackPanel></Grid></Border>
                </Grid>
            </Grid>

            <!-- 模型设置 -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding SelectedPage, Converter={StaticResource PageVisibility}, ConverterParameter=Settings}" IsEnabled="{Binding IsSettingsSelected}" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Margin="{StaticResource PageHeaderMargin}"><TextBlock Text="模型、密钥、连接验证与软件更新" Style="{StaticResource Kicker}" /><TextBlock Text="系统设置" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" /></StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.15*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.85*" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBorder}"><StackPanel><TextBlock Text="OpenAI 兼容接口" Style="{StaticResource SectionTitle}" /><TextBlock Text="接口地址" Style="{StaticResource Kicker}" Margin="0,14,0,6" /><TextBox Text="{Binding ModelEndpoint}" AutomationProperties.Name="Qwen 接口地址" /><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="150" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="模型名称" Style="{StaticResource Kicker}" /><TextBox Text="{Binding ModelName}" Margin="0,6,0,0" AutomationProperties.Name="Qwen 模型名称" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="超时（秒）" Style="{StaticResource Kicker}" /><TextBox Text="{Binding ModelTimeoutSeconds}" Margin="0,6,0,0" AutomationProperties.Name="模型超时秒数" /></StackPanel></Grid><TextBlock Text="百炼 API Key" Style="{StaticResource Kicker}" Margin="0,12,0,6" /><PasswordBox x:Name="ApiKeyBox" PasswordChanged="OnApiKeyPasswordChanged" MinHeight="{StaticResource ControlHeight}" Padding="10,6" AutomationProperties.Name="百炼 API Key" /><TextBlock Text="{Binding ApiKeyStatusText}" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="保存设置" Command="{Binding SaveModelSettingsCommand}" Margin="0,0,8,0" /><Button Content="保存并测试连接" Style="{StaticResource PrimaryButton}" Command="{Binding TestModelConnectionCommand}" Margin="0,0,8,0" /><Button Content="删除已保存密钥" Style="{StaticResource DangerButton}" Command="{Binding DeleteApiKeyCommand}" /></StackPanel></StackPanel></Border>
                        <Border Grid.Column="2" CornerRadius="16" Background="{StaticResource MintBrush}" Padding="20"><StackPanel><TextBlock Text="接入状态" Style="{StaticResource Kicker}" /><TextBlock Text="{Binding ModelReadyText}" FontSize="{StaticResource FontSizePageTitle}" LineHeight="{StaticResource LineHeightPageTitle}" FontWeight="Bold" Margin="0,8,0,0" /><TextBlock Text="{Binding ModelConnectionStatus}" Margin="0,7,0,4" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding ModelVerifiedAtText}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" Margin="0,0,0,16" /><Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="视觉与回复决策" FontWeight="Bold" /><TextBlock Text="截图识别、会话定位与回复生成使用同一个可配置 Qwen 视觉模型。" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,8"><StackPanel><TextBlock Text="密钥不写入配置" FontWeight="Bold" /><TextBlock Text="API Key 保存到当前 Windows 用户的凭据管理器。" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" /></StackPanel></Border><Border Background="White" CornerRadius="10" Padding="12"><StackPanel><TextBlock Text="配置变化自动锁定" FontWeight="Bold" /><TextBlock Text="模型、密钥或知识变化后，旧的模拟批准立即失效。" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" TextWrapping="Wrap" /></StackPanel></Border></StackPanel></Border>
                    </Grid>
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0" AutomationProperties.Name="软件更新">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.72*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="1.28*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="软件更新" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding CurrentVersionText}" Margin="0,8,0,0" FontWeight="SemiBold" />
                                <TextBlock Text="更新来源：GitHub 公开正式版本" Style="{StaticResource HelperText}" Margin="0,4,0,0" />
                                <WrapPanel Margin="0,16,0,0">
                                    <Button Content="检查更新" Command="{Binding CheckForUpdateCommand}" Margin="0,0,8,8" AutomationProperties.Name="检查软件更新" />
                                    <Button Content="{Binding UpdateActionText}" Style="{StaticResource PrimaryButton}" Command="{Binding DownloadAndInstallUpdateCommand}" IsEnabled="{Binding IsUpdateAvailable}" Margin="0,0,0,8" AutomationProperties.Name="下载并安装软件更新" />
                                </WrapPanel>
                            </StackPanel>
                            <Border Grid.Column="2" Background="{StaticResource CanvasBrush}" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="{Binding UpdateStatus}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="软件更新状态" />
                                    <ProgressBar Value="{Binding UpdateProgress, Mode=OneWay}" Maximum="100" Height="10" Margin="0,12,0,0" AutomationProperties.Name="软件下载进度" />
                                    <TextBlock Text="更新说明" Style="{StaticResource Kicker}" Margin="0,14,0,4" />
                                    <TextBlock Text="{Binding UpdateNotes}" Style="{StaticResource HelperText}" MaxHeight="150" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="安装前会校验 SHA-256；更新只覆盖程序目录，不会上传或删除本地客服资料与 API Key。" Style="{StaticResource HelperText}" Margin="0,12,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,0" AutomationProperties.LiveSetting="Polite" AutomationProperties.Name="应用状态">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="{StaticResource FontSizeSecondary}" LineHeight="{StaticResource LineHeightSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Border>
        </Grid>
    </Grid>
</Window>
