<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AgentDesk.Core\AgentDesk.Core.csproj" />
    <ProjectReference Include="..\AgentDesk.Automation\AgentDesk.Automation.csproj" />
    <ProjectReference Include="..\AgentDesk.AI\AgentDesk.AI.csproj" />
    <ProjectReference Include="..\AgentDesk.Infrastructure\AgentDesk.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>AgentDesk</AssemblyName>
    <AssemblyTitle>AI客服</AssemblyTitle>
    <Product>AI客服</Product>
    <Description>AI客服智能客服控制台</Description>
    <Version>0.5.0</Version>
    <RepositoryUrl>https://github.com/kobong1965/ai-customer-service</RepositoryUrl>
    <ApplicationIcon>Assets\ai-customer-service.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <HighDpiSupport>true</HighDpiSupport>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\ai-customer-service-logo.png" />
    <Resource Include="Assets\ai-customer-service.ico" />
  </ItemGroup>

</Project>
