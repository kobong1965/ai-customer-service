<Application x:Class="AgentDesk.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AgentDesk.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DesignTokens.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:PageVisibilityConverter x:Key="PageVisibility" />
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
